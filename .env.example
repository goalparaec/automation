# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project settings -> API -> service_role key (NOT the anon key). This is
# used server-side only, in API routes, and must never be exposed to the
# browser. Do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Company portal login, used by /api/fetch-report (the "Fetch from Portal"
# buttons on the Upload page). Server-side only.
PORTAL_USERNAME=your-portal-username
PORTAL_PASSWORD=your-portal-password
